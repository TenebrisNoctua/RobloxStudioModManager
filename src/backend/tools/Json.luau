-- Mostly generated by AI because I wasn't going to implement the entire JSON ser-des in C++.

const Yield = require("@Backend/tools/Yield")

-- Decoded objects and arrays keep what they were, so an empty one encodes back the same
const OBJECT = table.freeze({ __json = "object" })
const ARRAY = table.freeze({ __json = "array" })

const ESCAPES = {
	['"'] = '"',
	["\\"] = "\\",
	["/"] = "/",
	b = "\b",
	f = "\f",
	n = "\n",
	r = "\r",
	t = "\t",
}

local Json = {
	-- What decoded objects and arrays are marked with. Tables made by code can be marked with
	-- Json.object and Json.array too.
	OBJECT = OBJECT,
	ARRAY = ARRAY
}

--// Local Functions

-- A codepoint as UTF-8
local function encodeCodepoint(codepoint: number): string
	return utf8.char(codepoint)
end

local function decodeError(text: string, position: number, message: string): never
	local line = select(2, string.gsub(string.sub(text, 1, position), "\n", "")) + 1
	error(`{message} in JSON at line {line}`, 0)
end

-- Reads the value at position, returns it and the position after it
local function decodeValue(text: string, position: number): (any, number)
	position = string.find(text, "[^ \t\r\n]", position) or #text + 1
	local first = string.sub(text, position, position)

	if first == "{" then
		local object = setmetatable({}, OBJECT)
		position = string.find(text, "[^ \t\r\n]", position + 1) or #text + 1
		if string.sub(text, position, position) == "}" then
			return object, position + 1
		end
		while true do
			-- A big document, such as the client settings, decodes over a few frames
			Yield.ifNeeded()
			local key
			key, position = decodeValue(text, position)
			if type(key) ~= "string" then
				decodeError(text, position, "expected a key")
			end
			position = string.find(text, "[^ \t\r\n]", position) or #text + 1
			if string.sub(text, position, position) ~= ":" then
				decodeError(text, position, "expected ':'")
			end
			object[key], position = decodeValue(text, position + 1)
			position = string.find(text, "[^ \t\r\n]", position) or #text + 1
			local separator = string.sub(text, position, position)
			if separator == "}" then
				return object, position + 1
			elseif separator ~= "," then
				decodeError(text, position, "expected ',' or '}'")
			end
			position += 1
		end
	elseif first == "[" then
		local array = setmetatable({}, ARRAY)
		position = string.find(text, "[^ \t\r\n]", position + 1) or #text + 1
		if string.sub(text, position, position) == "]" then
			return array, position + 1
		end
		while true do
			Yield.ifNeeded()
			local item
			item, position = decodeValue(text, position)
			table.insert(array, item)
			position = string.find(text, "[^ \t\r\n]", position) or #text + 1
			local separator = string.sub(text, position, position)
			if separator == "]" then
				return array, position + 1
			elseif separator ~= "," then
				decodeError(text, position, "expected ',' or ']'")
			end
			position += 1
		end
	elseif first == '"' then
		local parts = {}
		position += 1
		while true do
			local stop = string.find(text, '["\\]', position)
			if not stop then
				decodeError(text, position, "unterminated string")
			end
			table.insert(parts, string.sub(text, position, stop - 1))
			if string.sub(text, stop, stop) == '"' then
				return table.concat(parts), stop + 1
			end
			local escape = string.sub(text, stop + 1, stop + 1)
			if escape == "u" then
				local codepoint = tonumber(string.sub(text, stop + 2, stop + 5), 16)
				if not codepoint then
					decodeError(text, stop, "bad \\u escape")
				end
				position = stop + 6
				-- A surrogate pair stands for one codepoint above the BMP
				if codepoint >= 0xD800 and codepoint <= 0xDBFF and string.sub(text, position, position + 1) == "\\u" then
					local low = tonumber(string.sub(text, position + 2, position + 5), 16)
					if low and low >= 0xDC00 and low <= 0xDFFF then
						codepoint = 0x10000 + (codepoint - 0xD800) * 0x400 + (low - 0xDC00)
						position += 6
					end
				end
				table.insert(parts, encodeCodepoint(codepoint))
			else
				local character = ESCAPES[escape]
				if not character then
					decodeError(text, stop, "bad escape")
				end
				table.insert(parts, character)
				position = stop + 2
			end
		end
	elseif first == "t" and string.sub(text, position, position + 3) == "true" then
		return true, position + 4
	elseif first == "f" and string.sub(text, position, position + 4) == "false" then
		return false, position + 5
	elseif first == "n" and string.sub(text, position, position + 3) == "null" then
		return nil, position + 4
	end

	local number = string.match(text, "^-?%d+%.?%d*[eE]?[-+]?%d*", position)
	if number and number ~= "" and tonumber(number) then
		return tonumber(number), position + #number
	end
	return decodeError(text, position, if first == "" then "unexpected end" else `unexpected '{first}'`)
end

local function encodeString(value: string): string
	local escaped = string.gsub(value, '[%c"\\]', function(character: string): string
		if character == '"' then
			return '\\"'
		elseif character == "\\" then
			return "\\\\"
		elseif character == "\n" then
			return "\\n"
		elseif character == "\r" then
			return "\\r"
		elseif character == "\t" then
			return "\\t"
		elseif character == "\b" then
			return "\\b"
		elseif character == "\f" then
			return "\\f"
		end
		return string.format("\\u%04x", string.byte(character))
	end)
	return '"' .. escaped .. '"'
end

-- Whether a table encodes as an array: marked as one, or a sequence made by code
local function isArray(value: { [any]: any }): boolean
	local mark = getmetatable(value)
	if mark == ARRAY then
		return true
	elseif mark == OBJECT then
		return false
	end
	return #value > 0 and next(value, #value) == nil
end

-- Keys in ordinal order, like OrdinalSortJson
local function sortedKeys(value: { [string]: any }): { string }
	local keys = {}
	for key in value do
		table.insert(keys, tostring(key))
	end
	table.sort(keys)
	return keys
end

local function encodeValue(value: any, indent: string?, depth: number, parts: { string })
	local kind = type(value)
	if kind == "string" then
		table.insert(parts, encodeString(value))
	elseif kind == "number" then
		if value == math.floor(value) and math.abs(value) < 2 ^ 53 then
			table.insert(parts, string.format("%d", value))
		else
			table.insert(parts, tostring(value))
		end
	elseif kind == "boolean" then
		table.insert(parts, if value then "true" else "false")
	elseif kind == "nil" then
		table.insert(parts, "null")
	elseif kind == "table" then
		local array = isArray(value)
		local keys = if array then nil else sortedKeys(value)
		local count = if array then #value else #(keys :: { string })
		if count == 0 then
			table.insert(parts, if array then "[]" else "{}")
			return
		end

		local inner = if indent then "\n" .. string.rep(indent, depth + 1) else ""
		local outer = if indent then "\n" .. string.rep(indent, depth) else ""
		table.insert(parts, if array then "[" else "{")
		if array then
			for index, item in value do
				-- A big document, such as the state, encodes over a few frames
				Yield.ifNeeded()
				table.insert(parts, (if index > 1 then "," else "") .. inner)
				encodeValue(item, indent, depth + 1, parts)
			end
		else
			for index, key in keys :: { string } do
				Yield.ifNeeded()
				table.insert(parts, (if index > 1 then "," else "") .. inner .. encodeString(key) .. (if indent then ": " else ":"))
				encodeValue(value[key], indent, depth + 1, parts)
			end
		end
		table.insert(parts, outer .. (if array then "]" else "}"))
	else
		error(`can't encode a {kind} as JSON`, 0)
	end
end

--// Module Functions

-- Decodes JSON text. Raises with the line of the first error.
function Json.decode(text: string): any
	local value, position = decodeValue(text, 1)
	position = string.find(text, "[^ \t\r\n]", position) or #text + 1
	if position <= #text then
		decodeError(text, position, "unexpected text after the value")
	end
	return value
end

--[[
	Encodes a value as JSON, with object keys in ordinal order. With indent,
	such as two spaces, it's laid out like Newtonsoft's Formatting.Indented.
]]
function Json.encode(value: any, indent: string?): string
	local parts = {}
	encodeValue(value, indent, 0, parts)
	return table.concat(parts)
end

-- Marks a table as an object, so it encodes as {} while empty
function Json.object(value: { [string]: any }?): { [string]: any }
	return setmetatable(value or {}, OBJECT)
end

-- Marks a table as an array, so it encodes as [] while empty
function Json.array(value: { any }?): { any }
	return setmetatable(value or {}, ARRAY)
end

return Json
