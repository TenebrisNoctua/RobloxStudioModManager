-- Mostly generated by AI, because porting this from C# to Luau would be extremely time consuming.

const fs = require("@Luwow/fs")
const Yield = require("@Backend/tools/Yield")

-- This snippet is present for each registered fflag in RobloxStudioBeta.exe
-- 00:  41 B8 ?? ?? ?? ??    | mov r8d, <val>     ; byte, determines if dynamic
-- 06:  48 8D 15 ?? ?? ?? ?? | lea rdx, <addr>    ;
-- 13:  48 8D 0D ?? ?? ?? ?? | lea rcx, <addr>    ; fflag name
-- 20:  E9 ?? ?? ?? ??       | jmp <addr>         ; registration routine, determines data type (FFlag, SFFlag, FString, etc)
const BASE_PATTERN = "41 B8 ?? 00 00 00 48 8D 15 ?? ?? ?? ?? 48 8D 0D ?? ?? ?? ?? E9 ?? ?? ?? ?? CC CC CC CC CC CC CC"

-- This snippet is present at the bottom of version'd fflag declarations. Everything that precedes up to
-- the fflag address is variable, but is a mixture of the instructions: mov, movsd, movzx, and movups
-- 00:  BA ?? ?? ?? ??
-- 05:  48 8D 4C 24 20
-- 10:  E8 ?? ?? ?? ??
const END_PATTERN = "BA ?? ?? ?? ?? 48 8D 4C 24 20 E8 ?? ?? ?? ??"

-- The registration routines for each flag type are stored in memory consecutively in this order
const DATA_TYPES = { "FFlag", "SFFlag", "FInt", "FLog" }

-- How far back a versioned flag's name load is looked for
const VERSION_SEARCH = 200

-- The executable is read in pages, the ones in use kept: 16 MB rather than all of it
const PAGE_SIZE = 65536
const MAX_PAGES = 256
-- How much of a name is read at once
const NAME_CHUNK = 128

local StudioFFlagDumper = {}

--// Types

type Section = {
	VirtualAddress: number,
	SizeOfRawData: number,
	PointerToRawData: number
}

type RawFFlagData = {
	DataTypeId: number,
	ByteParam: number,
	Name: string
}

type Reader = {
	File: any,
	Size: number,
	-- Page index -> its bytes, and the indices in the order they were read
	Pages: { [number]: string },
	Order: { number }
}

--// Local Functions

-- Reads the binary in pages through a file handle, instead of holding the whole executable
local function openReader(path: string): Reader
	local file = fs.open(path, "r")
	return {
		File = file,
		Size = file:size(),
		Pages = {},
		Order = {},
	}
end

local function page(reader: Reader, index: number): string
	local cached = reader.Pages[index]
	if cached then
		return cached
	end

	reader.File:seek("set", index * PAGE_SIZE)
	local data = reader.File:read(PAGE_SIZE)
	reader.Pages[index] = data
	table.insert(reader.Order, index)

	-- The matches are gone through in order, so the oldest page is the one done with
	if #reader.Order > MAX_PAGES then
		reader.Pages[table.remove(reader.Order, 1) :: number] = nil
	end
	return data
end

-- length bytes at a 0-based offset, fewer at the end of the file
local function readBytes(reader: Reader, offset: number, length: number): string
	if offset < 0 or length <= 0 or offset >= reader.Size then
		return ""
	end
	local first = offset // PAGE_SIZE
	local last = (math.min(offset + length, reader.Size) - 1) // PAGE_SIZE
	local start = offset - first * PAGE_SIZE + 1

	if first == last then
		return string.sub(page(reader, first), start, start + length - 1)
	end
	local parts = { string.sub(page(reader, first), start) }
	for index = first + 1, last do
		table.insert(parts, page(reader, index))
	end
	return string.sub(table.concat(parts), 1, length)
end

-- Bytes are 0-based offsets into the binary, like the C# byte array
local function byteAt(reader: Reader, offset: number): number
	return string.byte(readBytes(reader, offset, 1))
end

local function int32At(reader: Reader, offset: number): number
	return (string.unpack("<i4", readBytes(reader, offset, 4)))
end

-- The PE's section headers, by name
local function readSections(reader: Reader): { [string]: Section }
	local peOffset = int32At(reader, 0x3C)
	if readBytes(reader, peOffset, 4) ~= "PE\0\0" then
		error("not a PE file", 0)
	end

	local coff = peOffset + 4
	local sectionCount = string.unpack("<I2", readBytes(reader, coff + 2, 2))
	local optionalSize = string.unpack("<I2", readBytes(reader, coff + 16, 2))
	local tableOffset = coff + 20 + optionalSize

	local sections = {}
	for index = 0, sectionCount - 1 do
		local header = readBytes(reader, tableOffset + index * 40, 40)
		local name = string.match(string.sub(header, 1, 8), "^[^%z]*")
		sections[name] = {
			VirtualAddress = string.unpack("<I4", header, 12 + 1),
			SizeOfRawData = string.unpack("<I4", header, 16 + 1),
			PointerToRawData = string.unpack("<I4", header, 20 + 1),
		}
	end
	return sections
end

local function getRVAOffset(section: Section): number
	return section.VirtualAddress - section.PointerToRawData
end

-- A null terminated name at offset, nil when it has a byte out of 30 to 127
local function readName(reader: Reader, offset: number): string?
	if offset < 0 or offset >= reader.Size then
		return nil
	end

	local parts = {}
	local position = offset
	while position < reader.Size do
		local chunk = readBytes(reader, position, NAME_CHUNK)
		local stop = string.find(chunk, "\0", 1, true)
		if stop then
			table.insert(parts, string.sub(chunk, 1, stop - 1))
			local name = table.concat(parts)
			if string.find(name, "[^\30-\127]") then
				return nil
			end
			return name
		end
		table.insert(parts, chunk)
		position += #chunk
	end
	return nil
end

--[[
	The 0-based offset of each match, skipping past it like the scanner does. 
	The file is searched off the state by fs.findBytes, the matches are gone through here.
]]
local function scan(path: string, hexPattern: string, start: number, size: number, onMatch: (offset: number) -> ())
	for _, offset in fs.findBytes(path, hexPattern, start, size) do
		onMatch(offset)
		Yield.ifNeeded()
	end
end

-- The earliest RIP-relative load in the bytes before endOffset: its offset and length
local function findFirstLoad(reader: Reader, endOffset: number): (number, number)
	local searchStart = math.max(0, endOffset - VERSION_SEARCH)
	local firstLoadOffset, firstLoadLength = -1, 0

	-- The bytes from the search's start to the longest instruction starting just before endOffset
	local window = readBytes(reader, searchStart, endOffset - searchStart + 8)

	for i = endOffset - 1, searchStart, -1 do
		if i + 7 > reader.Size then
			continue
		end
		local b0, b1, b2, b3 = string.byte(window, i - searchStart + 1, i - searchStart + 4)
		local instrLength = 0

		-- movups xmm, [rip+offset]: 0F 10 05
		if b0 == 0x0F and b1 == 0x10 and b2 == 0x05 then
			instrLength = 7
		-- movsd xmm, [rip+offset]: F2 0F 10 05
		elseif b0 == 0xF2 and b1 == 0x0F and b2 == 0x10 and i + 8 <= reader.Size and b3 == 0x05 then
			instrLength = 8
		-- movzx reg, byte/word ptr [rip+offset]: 0F B6/B7 05
		elseif b0 == 0x0F and (b1 == 0xB6 or b1 == 0xB7) and b2 == 0x05 then
			instrLength = 7
		-- mov reg, [rip+offset]: 8B 0D
		elseif b0 == 0x8B and b1 == 0x0D then
			instrLength = 6
		end

		if instrLength > 0 then
			firstLoadOffset = i
			firstLoadLength = instrLength
		end
	end

	return firstLoadOffset, firstLoadLength
end

--// Module Functions

--[[
	Dumps all C++ defined flags found within the RobloxStudioBeta executable,
	sorted. The executable is searched off the state, the calling thread
	yields now and then meanwhile.
]]
function StudioFFlagDumper.DumpCppFlags(studioExePath: string): { string }
	local binary = openReader(studioExePath)
	local sections = readSections(binary)

	local textHeader = sections[".text"]
	local rdataHeader = sections[".rdata"]
	if not textHeader or not rdataHeader then
		error("RobloxStudioBeta.exe has no .text or .rdata section", 0)
	end
	local rvaOffset = getRVAOffset(textHeader) - getRVAOffset(rdataHeader)

	local textStart = textHeader.PointerToRawData
	local textSize = textHeader.SizeOfRawData

	local dataTypeTable: { [number]: string | boolean } = {}
	local rawFFlagData: { RawFFlagData } = {}
	local lastTargetOffset = 0

	scan(studioExePath, BASE_PATTERN, textStart, textSize, function(pos: number)
		local param = byteAt(binary, pos + 2)

		-- Resolving the pointer with a constant offset since we can just assume it will always point to .rdata
		local nameOffset = pos + 20 + int32At(binary, pos + 16) + rvaOffset
		local targetOffset = pos + 25 + int32At(binary, pos + 21)

		local name = readName(binary, nameOffset)
		local bad = name == nil

		if not bad and lastTargetOffset ~= 0 then
			-- !! FIXME: Garbage pattern match? What is going on here?
			bad = math.abs(lastTargetOffset - targetOffset) > 1000
		end

		if not bad then
			table.insert(rawFFlagData, { DataTypeId = targetOffset, ByteParam = param, Name = name :: string })

			if dataTypeTable[targetOffset] ~= nil then
				return
			end

			dataTypeTable[targetOffset] = false
			lastTargetOffset = targetOffset
		end
	end)

	-- The routines in memory order get the data types in order
	local routines = {}
	for offset in dataTypeTable do
		table.insert(routines, offset)
	end
	table.sort(routines)
	for index, dataType in DATA_TYPES do
		if routines[index] then
			dataTypeTable[routines[index]] = dataType
		end
	end

	-- Collect fflag versions
	local versions: { [string]: number } = {}

	scan(studioExePath, END_PATTERN, textStart, textSize, function(endOffset: number)
		-- Extract version number at offset + 1
		local version = int32At(binary, endOffset + 1)

		-- Work backwards to find the first RIP-relative load, up to 200 bytes back to handle long strings
		local firstLoadOffset, firstLoadLength = findFirstLoad(binary, endOffset)
		if firstLoadOffset < 0 then
			return
		end

		-- The offset is always the last 4 bytes of the instruction, the string is relative to the next one
		local offsetPosition = firstLoadOffset + firstLoadLength - 4
		local nameOffset = offsetPosition + 4 + rvaOffset + int32At(binary, offsetPosition)

		local name = readName(binary, nameOffset)
		if not name or string.match(name, "^%s*$") or versions[name] then
			return
		end
		versions[name] = version
	end)

	binary.File:close()

	local finalList = {}
	for _, entry in rawFFlagData do
		Yield.ifNeeded()
		local dataType = dataTypeTable[entry.DataTypeId]
		local name = if entry.ByteParam == 2 then "D" else ""

		name ..= if type(dataType) == "string" then dataType else "ERROR"
		name ..= entry.Name

		local version = versions[entry.Name]
		if version then
			name ..= tostring(version)
		end

		table.insert(finalList, name)
	end

	table.sort(finalList)
	return finalList
end

return StudioFFlagDumper
